# SmartAcc Environment Variables Template
# Copy to .env.local for local overrides. Keep all production credentials secure.

# Optional: Server-side lead delivery webhook or email service endpoint
VITE_LEAD_WEBHOOK_URL=

# Optional: Verified production canonical domain (e.g., https://smartacc.in)
VITE_CANONICAL_URL=

# Optional: Analytics adapter ID (disabled by default)
VITE_ANALYTICS_ID=
